# AI (same free Gemini key as JobFit)
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=

# Limits: uploads per visitor per UTC day, and AI calls for the whole app per UTC day
AI_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=200

# Secret for hashing visitor IPs (openssl rand -hex 32). Required in production.
VISITOR_SALT=

# Upstash Redis (either pair). Required in production; local dev uses memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sites allowed to call /api/scan from their pages (comma-separated), e.g. Brokwise
ALLOWED_ORIGINS=https://brokwise.vercel.app

# Pulse monitor (abdulsubhan-pulse.vercel.app): RegRead's log token. Off when empty.
MONITOR_LOG_TOKEN=
